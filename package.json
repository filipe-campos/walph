{
  "name": "walph",
  "productName": "Walph",
  "version": "0.7.0",
  "description": "A desktop IDE with Claude Code built in, made with Electron and React",
  "license": "MIT",
  "author": {
    "name": "Filipe Campos",
    "email": "filipefcl@hotmail.com"
  },
  "homepage": "https://github.com/filipe-campos/walph",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filipe-campos/walph.git"
  },
  "private": true,
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit -p tsconfig.node.json && node node_modules/typescript7/bin/tsc --noEmit -p tsconfig.node.test.json && node node_modules/typescript7/bin/tsc --noEmit -p tsconfig.web.json && node node_modules/typescript7/bin/tsc --noEmit -p tsconfig.web.test.json && node node_modules/typescript7/bin/tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "format": "eslint --fix . && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "electron-vite build && playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm knip && pnpm docs:check && pnpm test",
    "docs:check": "node scripts/check-doc-paths.mjs",
    "knip": "knip",
    "postinstall": "install-electron && electron-builder install-app-deps && node scripts/patch-electron-name.mjs",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@parcel/watcher": "^2.6.0",
    "@vscode/ripgrep": "^1.18.0",
    "electron-updater": "^6.8.11",
    "jsonc-parser": "^3.3.1",
    "node-pty": "^1.1.0",
    "tsserver-bundled": "npm:typescript@~6.0.3",
    "typescript-language-server": "^6.0.3",
    "vscode-jsonrpc": "^10.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@emmetio/html-matcher": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vscode/codicons": "^0.0.45",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "emmet": "^2.4.11",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "katex": "^0.19.1",
    "knip": "^6.44.2",
    "marked": "^18.1.3",
    "marked-alert": "^2.1.2",
    "marked-footnote": "^1.4.0",
    "marked-katex-extension": "^5.1.13",
    "mermaid": "^12.3.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  }
}
